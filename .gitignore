__pycache__/
*.py[cod]

# Build artifacts. `uv sync` and `uv build` both leave an egg-info beside the package.
build/
dist/
*.egg-info/

output/
output_*/

# Precomputed GT z-buffer cache -- regenerable from the dataset, not source.
gt_cache/

# Hidden files are ignored by default so credentials and local tool state (.token, .env,
# .netrc, editor/tool dirs) cannot be committed by accident. Dotfiles that SHOULD be tracked
# must be re-included explicitly below -- keep that list short and deliberate.
.*
!.gitignore
!.gitattributes
!.github/
# Agent discovery alias for the canonical root-level skills/ directory.
!.agents/
!.claude

# Belt-and-braces: named explicitly so they stay ignored even if the `.*` rule above is
# ever relaxed or a file lands in a subdirectory.
.token
.env
.env.*
*.token
*.key
*.pem
credentials.json
secrets.json


# Written into the checkout by the NGC CLI recipe in the setup skill's section 4.2. Neither is
# source: the zip is the installer and ngc-cli/ is what it unpacks to, both re-fetchable.
ngccli.zip
ngc-cli/
